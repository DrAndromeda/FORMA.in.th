{
  "name": "forma-bots",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "description": "Telegram and WhatsApp project-intake bots for FORMA — standalone from the Astro site build.",
  "scripts": {
    "telegram": "tsx watch telegram/index.ts",
    "telegram:start": "tsx telegram/index.ts",
    "whatsapp": "tsx watch whatsapp/index.ts",
    "whatsapp:start": "tsx whatsapp/index.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "dotenv": "^17.4.2",
    "express": "^4.21.2",
    "grammy": "^1.30.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  },
  "allowScripts": {
    "fsevents@2.3.3": true
  }
}
