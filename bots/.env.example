# Telegram bot — create with @BotFather, then add the bot to your internal staff chat/group
# and get that chat's id (e.g. via @getidsbot or the Bot API getUpdates response).
TELEGRAM_BOT_TOKEN=
TELEGRAM_STAFF_CHAT_ID=

# WhatsApp Cloud API — from the Meta developer app for this WhatsApp Business number.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Any string you choose — must match the value entered in the Meta webhook configuration.
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_PORT=3001

# Optional: forward completed WhatsApp leads into the same Telegram staff chat as a single
# unified intake inbox (requires TELEGRAM_BOT_TOKEN above to also be set).
WHATSAPP_STAFF_FORWARD_CHAT_ID=
