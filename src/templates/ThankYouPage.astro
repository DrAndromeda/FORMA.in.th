---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getDictionary } from '../i18n/dictionary';
import { localizePath, type Locale } from '../lib/i18n';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = getDictionary(locale);
---

<BaseLayout locale={locale} path="/thank-you/" title={t.form.successTitle} description={t.form.successBody} noindex>
  <section class="wrap flex min-h-[60vh] flex-col items-center justify-center py-20 text-center">
    <h1 class="max-w-xl">{t.form.successTitle}</h1>
    <p class="body-l mt-4 max-w-md text-ink-900/70">{t.form.successBody}</p>
    <a href={localizePath(locale, '/')} class="mt-8 inline-flex items-center rounded-full bg-ink-900 px-6 py-3 text-sm font-medium text-stone-50 hover:bg-olive-700">
      {t.notFound.cta}
    </a>
  </section>
</BaseLayout>
