---
import { Image } from 'astro:assets';
import { getImage } from '../../lib/images';
import { journalHref, localeSlug, type JournalEntry } from '../../lib/journal';
import type { Locale } from '../../lib/i18n';
import type { Dictionary } from '../../i18n/dictionary';

interface Props {
  locale: Locale;
  t: Dictionary;
  articles: JournalEntry[];
  heading?: string;
}
const { locale, t, articles, heading } = Astro.props;
---

<section class="wrap py-14 sm:py-20">
  {heading && <h2 class="mb-8">{heading}</h2>}
  <div class="content-grid">
    {
      articles.map((a) => (
        <a href={journalHref(locale, localeSlug(a))} class="group col-span-4 md:col-span-4 lg:col-span-4">
          <div class="aspect-[3/2] overflow-hidden rounded-2xl">
            <Image
              src={getImage(a.data.image)}
              alt={a.data.title}
              width={640}
              height={427}
              widths={[360, 480, 640]}
              sizes="(min-width: 1024px) 33vw, 100vw"
              format="avif"
              loading="lazy"
              class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
            />
          </div>
          <div class="pt-3">
            <p class="text-xs font-medium tracking-wide text-ink-900/60 uppercase">{a.data.readingMinutes} {t.common.minRead}</p>
            <h3 class="mt-1 text-lg">{a.data.title}</h3>
            <p class="body-m mt-1 text-ink-900/70 line-clamp-2">{a.data.description}</p>
          </div>
        </a>
      ))
    }
  </div>
</section>
