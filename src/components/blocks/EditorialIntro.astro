---
interface Props {
  heading: string;
  body: string;
  eyebrow?: string;
}
const { heading, body, eyebrow } = Astro.props;
---

<section class="wrap py-14 sm:py-20">
  <div class="content-grid">
    <div class="col-span-4 md:col-span-3 lg:col-span-4">
      {eyebrow && <p class="text-xs font-semibold tracking-wide text-olive-700 uppercase">{eyebrow}</p>}
      <h2 class="mt-3">{heading}</h2>
    </div>
    <div class="col-span-4 md:col-span-5 lg:col-span-7 lg:col-start-6">
      <p class="body-l text-ink-900/80">{body}</p>
    </div>
  </div>
</section>
