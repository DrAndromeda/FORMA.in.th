---
// Homepage variant 3 — "Local Expert." Light, warm tropical palette, natural
// textures, geo-first flat menu built around Koh Phangan expertise.
// Temporary comparison page — see docs/tasks/TASK-010-homepage-variants.md.
import { Image, getImage as astroGetImage } from 'astro:assets';
import BaseHead from '../../components/seo/BaseHead.astro';
import ProjectMosaic from '../../components/blocks/ProjectMosaic.astro';
import FAQAccordion from '../../components/blocks/FAQAccordion.astro';
import JournalCards from '../../components/blocks/JournalCards.astro';
import CTABanner from '../../components/blocks/CTABanner.astro';
import { getImage } from '../../lib/images';
import { getLocation } from '../../content/locations';
import { getService } from '../../content/services';
import { projects } from '../../content/projects';
import { getJournalArticles } from '../../lib/journal';
import { getDictionary } from '../../i18n/dictionary';

const t = getDictionary('en');
const kohPhangan = getLocation('koh-phangan')!;
const villaDesign = getService('villa-design')!;
const heroImage = await astroGetImage({ src: getImage('pool-villa'), width: 2400, height: 1500, format: 'avif', quality: 82 });
const featuredProjects = projects.slice(0, 3);
const articles = (await getJournalArticles('en')).slice(0, 3);
---

<html lang="en" dir="ltr">
  <head>
    <BaseHead locale="en" title="FORMA — Local Expert Variant (v3)" description="Homepage variant 3: Local Expert." path="/v3/" noindex availableLocales={['en']} />
  </head>
  <body class="atmosphere min-h-screen text-ink-900">
    <header class="sticky top-0 z-50 border-b border-olive-600/15 bg-stone-50/90 backdrop-blur-sm">
      <div class="wrap flex h-20 flex-wrap items-center justify-between gap-3 py-3">
        <a href="/v3/" class="font-display text-xl tracking-tight">FORMA</a>
        <nav aria-label="Primary" class="hidden flex-wrap items-center gap-1 lg:flex">
          <a href="/services/villa-design/" class="rounded-full px-3.5 py-2 text-sm font-medium hover:bg-olive-600/10">Villa Design on KP</a>
          <a href="/services/turnkey-projects/" class="rounded-full px-3.5 py-2 text-sm font-medium hover:bg-olive-600/10">Build Your Villa</a>
          <a href="/services/interior-design/" class="rounded-full px-3.5 py-2 text-sm font-medium hover:bg-olive-600/10">Interior &amp; Landscape</a>
          <a href="/projects/" class="rounded-full px-3.5 py-2 text-sm font-medium hover:bg-olive-600/10">Portfolio</a>
          <a href="/locations/koh-phangan/" class="rounded-full px-3.5 py-2 text-sm font-medium hover:bg-olive-600/10">Why Koh Phangan?</a>
          <a href="/journal/" class="rounded-full px-3.5 py-2 text-sm font-medium hover:bg-olive-600/10">Blog &amp; Guides</a>
        </nav>
        <a href="/contact/" class="inline-flex items-center rounded-full bg-ink-900 px-5 py-2.5 text-sm font-medium text-stone-50 hover:bg-olive-700">Start a Project</a>
      </div>
    </header>

    <main>
      <section class="relative h-[80svh] min-h-[30rem] overflow-hidden rounded-b-[2rem]">
        <Image src={heroImage.src} width={2400} height={1500} alt="Pool villa integrated with tropical landscape on Koh Phangan" loading="eager" fetchpriority="high" class="h-full w-full object-cover" />
        <div class="absolute inset-0 bg-gradient-to-t from-ink-900/55 via-transparent to-transparent" aria-hidden="true"></div>
        <div class="wrap absolute inset-x-0 bottom-0 pb-14">
          <p class="text-xs font-semibold tracking-wide text-stone-50/90 uppercase">The island's design-build studio</p>
          <h1 class="mt-3 max-w-2xl font-display text-5xl leading-tight text-stone-50 sm:text-6xl">
            We know Koh Phangan's terrain, climate and craft — because we build here.
          </h1>
          <a href="/contact/" class="mt-8 inline-flex items-center rounded-full bg-stone-50 px-6 py-3.5 text-sm font-medium text-ink-900 hover:bg-stone-200">Start a Project</a>
        </div>
      </section>

      <section class="wrap py-20">
        <div class="content-grid">
          <div class="col-span-4 md:col-span-3 lg:col-span-5">
            <p class="text-xs font-semibold tracking-wide text-olive-700 uppercase">Local knowledge</p>
            <h2 class="mt-3">{kohPhangan.translations.en.h1}</h2>
          </div>
          <div class="col-span-4 md:col-span-5 lg:col-span-7 lg:col-start-6">
            <p class="body-l text-ink-900/80">{kohPhangan.translations.en.intro}</p>
          </div>
        </div>
      </section>

      <section class="wrap py-20">
        <div class="grid items-center gap-12 lg:grid-cols-2">
          <div class="overflow-hidden rounded-3xl">
            <Image src={getImage(villaDesign.image)} alt={villaDesign.translations.en.h1} width={960} height={1080} widths={[480, 720, 960]} sizes="(min-width: 1024px) 50vw, 100vw" format="avif" loading="lazy" class="h-full w-full object-cover" />
          </div>
          <div>
            <h2>{villaDesign.translations.en.h1}</h2>
            <p class="body-l mt-5 text-ink-900/80">{villaDesign.translations.en.directAnswer}</p>
            <a href="/services/villa-design/" class="mt-6 inline-flex items-center gap-2 text-sm font-medium text-olive-700 hover:text-olive-600">Explore Villa Design →</a>
          </div>
        </div>
      </section>

      <section class="wrap py-20">
        <h2 class="mb-10">Recent work on the island</h2>
        <ProjectMosaic locale="en" projects={featuredProjects} />
      </section>

      <FAQAccordion locale="en" faqs={kohPhangan.translations.en.faqs} heading="Building on Koh Phangan — what to know" />

      {articles.length > 0 && <JournalCards locale="en" t={t} articles={articles} heading="Guides for building on the island" />}

      <CTABanner heading="Have land on Koh Phangan?" body="Tell us where it is and what you have in mind. We know this island's terrain well." cta={{ label: 'Start a Project', href: '/contact/' }} />
    </main>

    <footer class="border-t border-olive-600/15 py-10">
      <div class="wrap flex flex-col gap-4 text-sm text-ink-900/60 sm:flex-row sm:items-center sm:justify-between">
        <p>© {new Date().getFullYear()} FORMA</p>
        <p>Homepage variant 3 of 3 — Local Expert. See <a href="/v1/" class="underline">v1</a> / <a href="/v2/" class="underline">v2</a>.</p>
      </div>
    </footer>
  </body>
</html>
