---
import LocationPage from '../../../templates/LocationPage.astro';
import { translatedLocationSlugs } from '../../../content/locations';
import type { Locale } from '../../../lib/i18n';

export function getStaticPaths() {
  const translatedLocales: Locale[] = ['ru', 'th', 'he'];
  return translatedLocales.flatMap((locale) =>
    translatedLocationSlugs(locale).map((slug) => ({ params: { locale, slug } })),
  );
}

const { locale, slug } = Astro.params as { locale: Locale; slug: string };
---

<LocationPage locale={locale} slug={slug} />
