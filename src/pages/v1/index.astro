---
// Homepage variant 1 — "Editorial." Architecture-magazine style: large serif
// typography, full-bleed imagery, generous whitespace, minimal 5-item menu.
// Temporary comparison page — see docs/tasks/TASK-010-homepage-variants.md.
// noindex: not meant to be indexed while variants are being compared, and
// two of the three will be deleted once a decision is made.
import { Image, getImage as astroGetImage } from 'astro:assets';
import BaseHead from '../../components/seo/BaseHead.astro';
import CTABanner from '../../components/blocks/CTABanner.astro';
import ProjectMosaic from '../../components/blocks/ProjectMosaic.astro';
import JournalCards from '../../components/blocks/JournalCards.astro';
import { getImage } from '../../lib/images';
import { services } from '../../content/services';
import { projects } from '../../content/projects';
import { getJournalArticles } from '../../lib/journal';
import { getDictionary } from '../../i18n/dictionary';

const t = getDictionary('en');
const designServices = services.filter((s) => s.category === 'design').slice(0, 4);
const buildServices = services.filter((s) => s.category === 'build' || s.category === 'management').slice(0, 4);
const featuredProjects = projects.slice(0, 4);
const articles = (await getJournalArticles('en')).slice(0, 3);
const heroImage = await astroGetImage({ src: getImage('hero-villa'), width: 2400, height: 1500, format: 'avif', quality: 82 });
---

<html lang="en" dir="ltr">
  <head>
    <BaseHead locale="en" title="FORMA — Editorial Variant (v1)" description="Homepage variant 1: Editorial." path="/v1/" noindex availableLocales={['en']} />
    <style>
      body { background: #f7f4ef; }
    </style>
  </head>
  <body class="min-h-screen bg-stone-50 text-ink-900">
    <header class="border-b border-ink-900/10">
      <div class="wrap flex h-24 items-center justify-between">
        <a href="/v1/" class="font-display text-2xl tracking-tight">FORMA</a>
        <nav aria-label="Primary" class="hidden gap-10 md:flex">
          <a href="/projects/" class="text-sm tracking-wide uppercase hover:text-olive-700">Projects</a>
          <a href="/services/architecture/" class="text-sm tracking-wide uppercase hover:text-olive-700">Architecture &amp; Design</a>
          <a href="/services/construction/" class="text-sm tracking-wide uppercase hover:text-olive-700">Construction &amp; Build</a>
          <a href="/locations/koh-phangan/" class="text-sm tracking-wide uppercase hover:text-olive-700">Koh Phangan</a>
          <a href="/journal/" class="text-sm tracking-wide uppercase hover:text-olive-700">Journal</a>
        </nav>
        <a href="/contact/" class="text-sm font-medium underline decoration-terracotta-500 decoration-2 underline-offset-4">Start a Project</a>
      </div>
    </header>

    <main>
      <section class="relative h-[86svh] min-h-[32rem] overflow-hidden">
        <Image src={heroImage.src} width={2400} height={1500} alt="Editorial view of a FORMA villa on Koh Phangan" loading="eager" fetchpriority="high" class="h-full w-full object-cover" />
        <div class="absolute inset-0 bg-gradient-to-t from-ink-900/60 via-transparent to-transparent" aria-hidden="true"></div>
        <div class="wrap absolute inset-x-0 bottom-0 pb-16">
          <p class="text-sm tracking-[0.3em] text-stone-50/80 uppercase">Koh Phangan, Thailand</p>
          <h1 class="mt-4 max-w-4xl font-display text-6xl leading-[0.95] text-stone-50 sm:text-7xl lg:text-8xl">
            Architecture &amp; Design-Build on Koh Phangan
          </h1>
        </div>
      </section>

      <section class="wrap grid gap-12 py-24 lg:grid-cols-12">
        <p class="font-display text-3xl leading-tight lg:col-span-7 lg:col-start-3">
          Architecture, interiors and construction for distinctive villas and spaces in Koh
          Phangan — from concept and planning to completion, by a studio built around this
          island's terrain, climate and material logistics.
        </p>
      </section>

      <section class="wrap py-20">
        <h2 class="mb-10 font-display text-4xl">Architecture &amp; Design</h2>
        <div class="grid gap-8 sm:grid-cols-2 lg:grid-cols-4">
          {designServices.map((s) => {
            const tr = s.translations.en;
            return (
              <a href={`/services/${s.slug}/`} class="group block">
                <div class="aspect-[3/4] overflow-hidden">
                  <Image src={getImage(s.image)} alt={tr.h1} width={480} height={640} widths={[320, 480]} sizes="25vw" format="avif" loading="lazy" class="h-full w-full object-cover transition-transform duration-700 group-hover:scale-105" />
                </div>
                <h3 class="mt-4 font-display text-xl">{tr.navLabel}</h3>
                <p class="mt-1 text-sm text-ink-900/60">{tr.cardSummary}</p>
              </a>
            );
          })}
        </div>
      </section>

      <section class="wrap py-20">
        <h2 class="mb-10 font-display text-4xl">Construction &amp; Build</h2>
        <div class="grid gap-8 sm:grid-cols-2 lg:grid-cols-4">
          {buildServices.map((s) => {
            const tr = s.translations.en;
            return (
              <a href={`/services/${s.slug}/`} class="group block">
                <div class="aspect-[3/4] overflow-hidden">
                  <Image src={getImage(s.image)} alt={tr.h1} width={480} height={640} widths={[320, 480]} sizes="25vw" format="avif" loading="lazy" class="h-full w-full object-cover transition-transform duration-700 group-hover:scale-105" />
                </div>
                <h3 class="mt-4 font-display text-xl">{tr.navLabel}</h3>
                <p class="mt-1 text-sm text-ink-900/60">{tr.cardSummary}</p>
              </a>
            );
          })}
        </div>
      </section>

      <section class="wrap py-20">
        <h2 class="mb-10 font-display text-4xl">Selected Work</h2>
        <ProjectMosaic locale="en" projects={featuredProjects} />
      </section>

      {articles.length > 0 && <JournalCards locale="en" t={t} articles={articles} heading="From the Journal" />}

      <CTABanner heading="Have a project in mind?" body="Tell us about your site and vision." cta={{ label: 'Start a Project', href: '/contact/' }} />
    </main>

    <footer class="border-t border-ink-900/10 py-10">
      <div class="wrap flex flex-col gap-4 text-sm text-ink-900/60 sm:flex-row sm:items-center sm:justify-between">
        <p>© {new Date().getFullYear()} FORMA</p>
        <p>Homepage variant 1 of 3 — Editorial. See <a href="/v2/" class="underline">v2</a> / <a href="/v3/" class="underline">v3</a>.</p>
      </div>
    </footer>
  </body>
</html>
