---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/layout/Breadcrumbs.astro';
import { legalEn } from '../../content/legal/en';

const p = legalEn.cookies;
---

<BaseLayout locale="en" path="/cookies/" title={p.title} description={p.description} availableLocales={['en']}>
  <Breadcrumbs locale="en" items={[{ name: 'Cookie Settings', path: '/cookies/' }]} />
  <section class="wrap py-14 sm:py-20">
    <div class="prose-article">
      <h1 class="mb-2">{p.h1}</h1>
      <p class="text-sm text-ink-900/50">{p.updated}</p>
      <p class="mt-6">{p.intro}</p>
      {
        p.categories.map((cat) => (
          <div class="mt-6">
            <h2>{cat.title}</h2>
            <p>{cat.body}</p>
          </div>
        ))
      }
    </div>
    <button
      type="button"
      id="manage-cookies"
      class="mt-8 inline-flex items-center rounded-full bg-ink-900 px-6 py-3 text-sm font-medium text-stone-50 hover:bg-olive-700"
    >
      Manage cookie preferences
    </button>
  </section>
</BaseLayout>

<script>
  document.getElementById('manage-cookies')?.addEventListener('click', () => {
    (window as unknown as { formaOpenCookieSettings?: () => void }).formaOpenCookieSettings?.();
  });
</script>
