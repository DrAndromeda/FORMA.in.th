# Environment variables for the Cloudflare Pages Function at functions/api/lead.ts
# (the site's contact form intake). Set these in the Cloudflare Pages project settings —
# never commit real values.

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional: bind a KV namespace named LEAD_RATE_LIMIT_KV in the Cloudflare Pages dashboard
# for basic per-IP rate limiting on the lead form. Without it, rate limiting is skipped
# (see functions/api/lead.ts).

# The bots/ directory (Telegram + WhatsApp intake bots) is a separate standalone Node
# project with its own .env — see bots/.env.example.
